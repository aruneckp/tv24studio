# ---- TV24 Newsroom agent server ----
# Copy to .env and edit. Everything is optional: with no LLM configured the
# Editor agent falls back to a rule-based script, and with no internet the
# Collector falls back to the bundled sample stories.

# Comma-separated RSS feeds the Collector agent reads
FEEDS=https://feeds.bbci.co.uk/telugu/rss.xml,https://news.google.com/rss/search?q=Andhra+Pradesh&hl=te&gl=IN&ceid=IN:te

# Any OpenAI-compatible chat endpoint. Free/local options:
#   Ollama  : LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   (no key)
#   Groq    : LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   Gemini  : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Free Microsoft neural Telugu voices via edge-tts
VOICE_FEMALE=te-IN-ShrutiNeural
VOICE_MALE=te-IN-MohanNeural
VOICE_RATE=+0%

# Frontend origin(s) allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
